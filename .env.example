# Copia este archivo a `.env` y completa los valores.
# `.env` NO debe versionarse (está en .gitignore).
# En GitHub Actions el token se inyecta como Secret del repositorio
# (Settings > Secrets and variables > Actions > `INSTAGRAM_TOKEN`),
# por lo que `.env` solo se usa para ejecutar `api/update_instagram.py` localmente.

# Token de larga duración de la Instagram Graph API (Business/Messenger).
# Requiere el permiso `instagram_basic` y el hashtag del negocio.
INSTAGRAM_TOKEN=
